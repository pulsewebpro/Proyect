DATABASE_URL="postgresql://amable:amable@localhost:5432/amable?schema=public"
AUTH_SECRET="dev-secret-change-in-production-min-16-chars"
PUBLIC_APP_URL="http://localhost:3000"
REDIS_URL="redis://127.0.0.1:6379"

# OAuth (opcional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Import / export GitHub (API; PAT con scope repo para export y repos privados)
GITHUB_IMPORT_TOKEN=""

# LLM runs (producción: al menos uno obligatorio; en local sin keys se usa mock)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Opcional — modelos por defecto en código si vacío
OPENAI_MODEL=""
ANTHROPIC_MODEL=""
# Saltar build Vite en CI o entornos sin npm (preview/publicación usan esbuild)
AMABLE_SKIP_VITE=""

# Panel operaciones (métricas en /admin/ops)
OPERATIONS_SECRET=""

# Cron: Authorization Bearer en GET /api/cron/cleanup-password-tokens
CRON_SECRET=""

# Email (Resend) — recuperación de contraseña
RESEND_API_KEY=""
RESEND_FROM="Equipo <onboarding@resend.dev>"
SUPPORT_EMAIL="soporte@tudominio.com"

# Registro público: 1 (defecto) o 0 para cerrar
REGISTRATION_OPEN="1"

# Health check estricto (503 si faltan LLM keys o Redis mal)
HEALTH_STRICT=""
