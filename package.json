{
  "name": "amable-studio",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @amable/web exec playwright test",
    "db:generate": "pnpm --filter @amable/db exec prisma generate",
    "db:migrate": "pnpm --filter @amable/db exec prisma migrate dev",
    "db:push": "pnpm --filter @amable/db exec prisma db push",
    "db:seed": "pnpm --filter @amable/db exec prisma db seed",
    "db:studio": "pnpm --filter @amable/db exec prisma studio",
    "openapi": "pnpm --filter @amable/web exec tsx scripts/generate-openapi.ts",
    "screenshots": "pnpm --filter @amable/web exec tsx scripts/capture-screens.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
